{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KYC Counterparty Report v1.1",
  "type": "object",
  "required": [
    "metadata", "counterparty", "deal_profile", "executive_summary", "sources", "source_coverage",
    "general_info", "financial_analysis", "legal_history", "related_parties", "specialized_analysis",
    "risk_map", "scores", "decision_conditions", "documents_conditions", "control_matrix",
    "enhanced_due_diligence", "limitations"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["report_title", "report_date", "source_cutoff_date", "version", "jurisdiction", "evidence_sufficiency", "document_status"],
      "properties": {
        "report_title": {"type": "string", "minLength": 5},
        "report_date": {"type": "string"},
        "source_cutoff_date": {"type": "string"},
        "version": {"type": "string"},
        "jurisdiction": {"type": "string"},
        "evidence_sufficiency": {"enum": ["Высокая", "Средняя", "Низкая"]},
        "document_status": {"type": "string", "minLength": 5}
      }
    },
    "counterparty": {
      "type": "object",
      "required": ["name", "inn", "ogrn", "kpp", "role", "purpose"],
      "properties": {
        "name": {"type": "string"}, "inn": {"type": "string"}, "ogrn": {"type": "string"},
        "kpp": {"type": "string"}, "role": {"enum": ["Заказчик", "Подрядчик"]}, "purpose": {"type": "string"}
      }
    },
    "deal_profile": {
      "type": "object",
      "required": ["assessment_scope", "completeness", "subject", "price", "advance", "stages", "payment_terms", "acceptance_terms", "open_exposure", "security", "funding_source", "missing_critical", "proposed_limit", "limit_basis", "limit_approval"],
      "properties": {
        "assessment_scope": {"enum": ["preliminary", "final"]},
        "completeness": {"enum": ["Полная", "Частичная", "Не представлена"]},
        "subject": {"type": "string"}, "price": {"type": "string"}, "advance": {"type": "string"},
        "stages": {"type": "string"}, "payment_terms": {"type": "string"}, "acceptance_terms": {"type": "string"},
        "open_exposure": {"type": "string"}, "security": {"type": "string"}, "funding_source": {"type": "string"},
        "missing_critical": {"type": "array", "items": {"type": "string"}},
        "proposed_limit": {"type": "string"}, "limit_basis": {"type": "string"}, "limit_approval": {"type": "string"}
      }
    },
    "executive_summary": {
      "type": "object",
      "required": ["overall_risk", "risk_label", "decision", "key_question", "reasons", "critical_risks", "preconditions"],
      "properties": {
        "overall_risk": {"type": "integer", "minimum": 1, "maximum": 10},
        "risk_label": {"type": "string"},
        "decision": {"enum": ["Допустить", "Допустить при выполнении условий", "Не рекомендуется"]},
        "key_question": {"type": "string"},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "critical_risks": {"type": "array", "items": {"type": "string"}},
        "preconditions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "source_coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceCoverage"}},
    "general_info": {"type": "array", "items": {"$ref": "#/$defs/infoRow"}},
    "financial_analysis": {"$ref": "#/$defs/analysisBlock"},
    "legal_history": {"$ref": "#/$defs/analysisBlock"},
    "related_parties": {"$ref": "#/$defs/analysisBlock"},
    "specialized_analysis": {"$ref": "#/$defs/analysisBlock"},
    "risk_map": {"type": "array", "items": {"type": "object", "required": ["risk", "level", "importance", "control", "preventive"]}},
    "scores": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "required": ["name", "score", "comment"]}},
    "decision_conditions": {"type": "object"},
    "documents_conditions": {"type": "object"},
    "control_matrix": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/control"}},
    "enhanced_due_diligence": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "evidenceStatus": {"enum": ["primary_verified", "document_verified", "secondary_signal", "conflict", "not_confirmed", "not_checked", "source_unavailable", "not_found"]},
    "source": {
      "type": "object", "required": ["name", "date", "status", "result"],
      "properties": {"name": {"type": "string"}, "date": {"type": "string"}, "status": {"$ref": "#/$defs/evidenceStatus"}, "result": {"type": "string"}}
    },
    "sourceCoverage": {
      "type": "object", "required": ["source", "required", "checked", "date", "evidence_status", "decision_impact"],
      "properties": {
        "source": {"type": "string"}, "required": {"type": "boolean"}, "checked": {"type": "boolean"},
        "date": {"type": "string"}, "evidence_status": {"$ref": "#/$defs/evidenceStatus"}, "decision_impact": {"type": "string"}
      }
    },
    "control": {
      "type": "object", "required": ["risk", "contract_control", "trigger", "required_evidence", "owner", "monitoring", "consequence"],
      "properties": {
        "risk": {"type": "string"}, "contract_control": {"type": "string"}, "trigger": {"type": "string"},
        "required_evidence": {"type": "string"}, "owner": {"type": "string"}, "monitoring": {"type": "string"}, "consequence": {"type": "string"}
      }
    },
    "infoRow": {"type": "object", "required": ["indicator", "data", "assessment"]},
    "analysisBlock": {"type": "object", "required": ["score", "conclusion"]}
  }
}
